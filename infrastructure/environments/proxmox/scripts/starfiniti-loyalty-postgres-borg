#!/usr/bin/env bash
set -Eeuo pipefail

umask 077

fail() {
  printf 'starfiniti-loyalty-postgres-borg: %s\n' "$*" >&2
  exit 1
}

readonly config_file="${STARFINITI_POSTGRES_BORG_CONFIG:-/etc/starfiniti-backup/pve-borg.env}"
[[ -r "$config_file" ]] || fail "configuration is not readable: $config_file"

# shellcheck source=/dev/null
source "$config_file"

: "${BORG_REPO:?BORG_REPO is required}"
: "${STARFINITI_POSTGRES_BORG_REPO:?STARFINITI_POSTGRES_BORG_REPO is required}"
: "${STARFINITI_WHOLE_VM_BORG_REPOSITORY_ID:?STARFINITI_WHOLE_VM_BORG_REPOSITORY_ID is required}"
: "${STARFINITI_POSTGRES_BORG_REPOSITORY_ID:?STARFINITI_POSTGRES_BORG_REPOSITORY_ID is required}"
: "${BORG_RSH:?BORG_RSH is required}"
: "${BORG_PASSCOMMAND:?BORG_PASSCOMMAND is required}"
: "${BORG_REMOTE_PATH:?BORG_REMOTE_PATH is required}"
: "${BORG_COMPRESSION:?BORG_COMPRESSION is required}"

readonly whole_vm_borg_repo="$BORG_REPO"
[[ "$STARFINITI_POSTGRES_BORG_REPO" != "$whole_vm_borg_repo" ]] ||
  fail "PostgreSQL and whole-VM backups must use distinct Borg repositories"
[[ "$STARFINITI_WHOLE_VM_BORG_REPOSITORY_ID" =~ ^[0-9a-f]{64}$ ]] ||
  fail "whole-VM Borg repository ID must be 64 lowercase hexadecimal characters"
[[ "$STARFINITI_POSTGRES_BORG_REPOSITORY_ID" =~ ^[0-9a-f]{64}$ ]] ||
  fail "PostgreSQL Borg repository ID must be 64 lowercase hexadecimal characters"
[[ "$STARFINITI_POSTGRES_BORG_REPOSITORY_ID" != "$STARFINITI_WHOLE_VM_BORG_REPOSITORY_ID" ]] ||
  fail "PostgreSQL and whole-VM Borg repository IDs must differ"

BORG_REPO="$STARFINITI_POSTGRES_BORG_REPO"
export BORG_REPO BORG_RSH BORG_PASSCOMMAND
export BORG_UNKNOWN_UNENCRYPTED_REPO_ACCESS_IS_OK=no
export BORG_RELOCATED_REPO_ACCESS_IS_OK=no

readonly guest_host="${STARFINITI_POSTGRES_GUEST_HOST:-10.10.10.71}"
readonly stage_root="${STARFINITI_POSTGRES_STAGE_ROOT:-/var/lib/starfiniti-postgres-backup-stage}"
readonly lock_file="${STARFINITI_POSTGRES_BORG_LOCK_FILE:-/run/lock/starfiniti-loyalty-postgres-borg.lock}"
readonly lock_wait_seconds="${STARFINITI_POSTGRES_BORG_LOCK_WAIT_SECONDS:-120}"
readonly whole_vm_lock_file="/run/lock/starfiniti-pve-borg.lock"
readonly monitoring_environment="${STARFINITI_MONITORING_ENVIRONMENT:-production}"
readonly metrics_dir="${STARFINITI_POSTGRES_BORG_METRICS_DIR:-/var/lib/node_exporter/textfile_collector}"
readonly metrics_state_dir="${STARFINITI_POSTGRES_BORG_METRICS_STATE_DIR:-/var/lib/starfiniti-postgres-borg/metrics-state}"
readonly archive_metrics_file="$metrics_dir/starfiniti-postgres-borg-archive.prom"
readonly repository_metrics_file="$metrics_dir/starfiniti-postgres-borg-repository.prom"
readonly archive_success_state="$metrics_state_dir/archive-last-success"
readonly repository_isolated_state="$metrics_state_dir/repository-isolated"

[[ "$lock_file" != "$whole_vm_lock_file" ]] ||
  fail "PostgreSQL backup must not use the whole-VM repository lock"

[[ "$lock_wait_seconds" =~ ^[1-9][0-9]{0,2}$ ]] &&
  ((lock_wait_seconds <= 120)) ||
  fail "lock wait must be an integer from 1 through 120 seconds"

[[ "$monitoring_environment" =~ ^[a-z][a-z0-9-]{1,31}$ ]] ||
  fail "monitoring environment must be a bounded lowercase label"

for command_name in borg chmod flock install jq mktemp mv rsync; do
  command -v "$command_name" >/dev/null 2>&1 || fail "required command is missing: $command_name"
done

prepare_metrics_storage() {
  if [[ -L "$metrics_dir" || ( -e "$metrics_dir" && ! -d "$metrics_dir" ) ]]; then
    return 1
  fi
  if [[ ! -d "$metrics_dir" ]]; then
    install -d -m 0755 "$metrics_dir" || return 1
  fi
  [[ -w "$metrics_dir" && -x "$metrics_dir" ]] || return 1

  if [[ -L "$metrics_state_dir" || ( -e "$metrics_state_dir" && ! -d "$metrics_state_dir" ) ]]; then
    return 1
  fi
  install -d -m 0700 "$metrics_state_dir"
}

metrics_ready=1
if ! prepare_metrics_storage; then
  metrics_ready=0
  printf 'starfiniti-loyalty-postgres-borg: metrics storage unavailable; archive will continue and the completed unit will fail evidence publication\n' >&2
fi

read_numeric_state() {
  local state_file="$1"
  local fallback="$2"
  local value

  if [[ -r "$state_file" ]]; then
    IFS= read -r value <"$state_file" || value=""
    if [[ "$value" =~ ^[0-9]{1,19}$ ]]; then
      printf '%s\n' "$value"
      return
    fi
  fi
  printf '%s\n' "$fallback"
}

write_numeric_state() {
  local state_file="$1"
  local value="$2"
  local temporary

  temporary="$(mktemp "${state_file}.tmp.XXXXXX")"
  printf '%s\n' "$value" >"$temporary"
  mv -f "$temporary" "$state_file"
}

publish_archive_metrics() {
  local attempt_success="$1"
  local completed_at="$2"
  local temporary

  temporary="$(mktemp "${archive_metrics_file}.tmp.XXXXXX")"
  {
    printf '# HELP starfiniti_postgres_offsite_archive_unixtime_seconds Unix time of the last completed dedicated PostgreSQL Borg archive.\n'
    printf '# TYPE starfiniti_postgres_offsite_archive_unixtime_seconds gauge\n'
    printf 'starfiniti_postgres_offsite_archive_unixtime_seconds{environment="%s",service="starfiniti-loyalty"} %s\n' "$monitoring_environment" "$completed_at"
    printf '# HELP starfiniti_postgres_offsite_archive_last_attempt_success Whether the last completed dedicated PostgreSQL Borg archive attempt succeeded.\n'
    printf '# TYPE starfiniti_postgres_offsite_archive_last_attempt_success gauge\n'
    printf 'starfiniti_postgres_offsite_archive_last_attempt_success{environment="%s",service="starfiniti-loyalty"} %s\n' "$monitoring_environment" "$attempt_success"
  } >"$temporary"
  chmod 0644 "$temporary"
  mv -f "$temporary" "$archive_metrics_file"
}

publish_repository_metric() {
  local isolated="$1"
  local temporary

  temporary="$(mktemp "${repository_metrics_file}.tmp.XXXXXX")"
  {
    printf '# HELP starfiniti_postgres_borg_repository_isolated Whether the configured and actual PostgreSQL Borg repository is distinct from the whole-VM repository.\n'
    printf '# TYPE starfiniti_postgres_borg_repository_isolated gauge\n'
    printf 'starfiniti_postgres_borg_repository_isolated{environment="%s",service="starfiniti-loyalty"} %s\n' "$monitoring_environment" "$isolated"
  } >"$temporary"
  chmod 0644 "$temporary"
  mv -f "$temporary" "$repository_metrics_file"
}

archive_last_success=0
repository_isolated=0
if ((metrics_ready)); then
  archive_last_success="$(read_numeric_state "$archive_success_state" 0)"
  repository_isolated="$(read_numeric_state "$repository_isolated_state" 0)"
fi

record_failed_attempt() {
  local status=$?

  if ((status != 0 && metrics_ready)); then
    publish_archive_metrics 0 "$archive_last_success" ||
      printf 'starfiniti-loyalty-postgres-borg: failed to publish failed-attempt metrics\n' >&2
  fi
  return "$status"
}

trap record_failed_attempt EXIT

verify_repository_identity() {
  local actual_repository_id

  actual_repository_id="$(
    borg info \
      --remote-path "$BORG_REMOTE_PATH" \
      --json \
      --lock-wait "$lock_wait_seconds" \
      "$BORG_REPO" |
      jq -er '.repository.id | select(type == "string" and test("^[0-9a-f]{64}$"))'
  )" || fail "dedicated PostgreSQL Borg repository identity could not be verified"

  if [[ "$actual_repository_id" != "$STARFINITI_POSTGRES_BORG_REPOSITORY_ID" ]]; then
    repository_isolated=0
    if ((metrics_ready)); then
      write_numeric_state "$repository_isolated_state" "$repository_isolated" &&
        publish_repository_metric "$repository_isolated" ||
        printf 'starfiniti-loyalty-postgres-borg: failed to publish repository-isolation failure\n' >&2
    fi
    fail "dedicated PostgreSQL Borg repository identity does not match approved configuration"
  fi

  repository_isolated=1
  if ((metrics_ready)); then
    if ! write_numeric_state "$repository_isolated_state" "$repository_isolated" ||
      ! publish_repository_metric "$repository_isolated"; then
      metrics_ready=0
      printf 'starfiniti-loyalty-postgres-borg: repository isolation verified but evidence publication failed\n' >&2
    fi
  fi
}

install -d -m 0700 "$stage_root"

# The remote forced command exposes only a read-only rrsync view. Rsync writes
# each immutable file atomically on the Proxmox host, preserves timestamps for
# Borg's files cache, and removes local staging files only after the source no
# longer retains them. It never deletes or writes a file on the database VM.
export RSYNC_RSH="ssh -i /root/.ssh/starfiniti-loyalty-backup-pull -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/etc/starfiniti-backup/loyalty-guest-known-hosts"
rsync \
  --archive \
  --chmod=D700,F600 \
  --chown=root:root \
  --compress-choice=zstd \
  --compress-level=3 \
  --delete-delay \
  --exclude='*.partial' \
  --ignore-existing \
  --stats \
  --timeout=120 \
  "vault-admin@${guest_host}:/" \
  "$stage_root/"

if [[ ! -d "$stage_root/base" || ! -d "$stage_root/wal" ]]; then
  fail "staged backup set unavailable"
fi

# Staging does not access the Borg repository and must continue even while
# retention owns the repository. Only the repository write is serialized.
exec 9>"$lock_file"
flock \
  --exclusive \
  --timeout "$lock_wait_seconds" \
  --conflict-exit-code 75 \
  9 || {
  lock_status=$?
  readonly lock_status
  printf 'starfiniti-loyalty-postgres-borg: dedicated repository lock unavailable after %s seconds; incremental archive not created\n' "$lock_wait_seconds" >&2
  exit "$lock_status"
}

verify_repository_identity

stamp=$(date -u +%Y%m%dT%H%M%SZ)
readonly archive="loyalty-postgres-$stamp"

ionice -c2 -n7 nice -n 10 borg create \
  --remote-path "$BORG_REMOTE_PATH" \
  --lock-wait "$lock_wait_seconds" \
  --compression "$BORG_COMPRESSION" \
  --files-cache ctime,size,inode \
  --one-file-system \
  --show-rc \
  --stats \
  "${BORG_REPO}::${archive}" \
  "$stage_root"

archive_last_success="$(date -u +%s)"
metrics_published=0
if ((metrics_ready)) &&
  write_numeric_state "$archive_success_state" "$archive_last_success" &&
  publish_archive_metrics 1 "$archive_last_success"; then
  metrics_published=1
fi
trap - EXIT

printf 'starfiniti-loyalty-postgres-borg: created %s\n' "$archive"
((metrics_published)) || fail "archive exists but observability evidence was not published"
