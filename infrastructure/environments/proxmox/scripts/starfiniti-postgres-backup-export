#!/usr/bin/env bash
set -Eeuo pipefail

umask 077

readonly backup_root="${STARFINITI_POSTGRES_BACKUP_ROOT:-/opt/starfiniti/supabase-prod/backups}"

if [[ ! -d "$backup_root/base" || ! -d "$backup_root/wal" ]]; then
  printf 'starfiniti-postgres-backup-export: backup set unavailable\n' >&2
  exit 1
fi

cd "$backup_root"

# PostgreSQL finalizes each archived WAL segment before the next archive command
# succeeds. Snapshot the names first and pass only regular files to tar so a new
# segment changing the wal directory mtime cannot invalidate the export. A base
# backup still being written uses the .partial suffix and is intentionally
# deferred to the next export.
find base wal -xdev -type f ! -name '*.partial' -print0 \
  | LC_ALL=C sort -z \
  | tar \
      --numeric-owner \
      --null \
      --no-recursion \
      --files-from=- \
      -cf -
