[Unit]
Description=Incremental encrypted Starfiniti Loyalty PostgreSQL backup to Borg
Wants=network-online.target
After=network-online.target pve-cluster.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/starfiniti-loyalty-postgres-borg
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
Environment=BORG_CACHE_DIR=/var/cache/starfiniti-borg
Environment=BORG_SECURITY_DIR=/var/lib/starfiniti-borg/security
CacheDirectory=starfiniti-borg
CacheDirectoryMode=0700
StateDirectory=starfiniti-borg starfiniti-postgres-backup-stage
StateDirectoryMode=0700
ReadWritePaths=/run/lock
TimeoutStartSec=30m
