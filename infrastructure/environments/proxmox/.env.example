COMPOSE_PROJECT_NAME=starfiniti-loyalty
DASHBOARD_IMAGE=ghcr.io/starfiniti/loyalty-dashboard:replace-with-immutable-tag
NEXT_PUBLIC_SUPABASE_URL=https://api.loyalty.example.com
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
DATABASE_URL=postgresql://replace-with-secret-managed-runtime-url
LOYALTY_WORKER_DATABASE_URL=postgresql://replace-with-secret-managed-worker-url
WOOCOMMERCE_SIGNING_MATERIAL_PATH=/etc/starfiniti-loyalty/woocommerce-signing-material.json

