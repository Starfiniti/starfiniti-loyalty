COMPOSE_PROJECT_NAME=starfiniti-loyalty
DASHBOARD_IMAGE=ghcr.io/starfiniti/loyalty-dashboard:replace-with-immutable-tag
WORKER_IMAGE=ghcr.io/starfiniti/loyalty-worker:replace-with-immutable-tag
NEXT_PUBLIC_SUPABASE_URL=https://api.loyalty.example.com
SUPABASE_PUBLIC_HOST=api.loyalty.example.com
SUPABASE_INTERNAL_PROXY_IP=10.10.10.30
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
DASHBOARD_PUBLIC_ORIGIN=https://loyalty.example.com
DASHBOARD_BIND_ADDRESS=127.0.0.1
DATABASE_URL=postgresql://replace-with-secret-managed-runtime-url
LOYALTY_WORKER_DATABASE_URL=postgresql://replace-with-secret-managed-worker-url

# Optional managed-only Stripe webhook intake. Keep empty until the M14 sandbox
# endpoint, secret distribution, tenant canary, and rollback are approved.
LOYALTY_STRIPE_WEBHOOK_SECRET_PATH=
LOYALTY_STRIPE_API_KEY_PATH=
# Optional managed-only restricted key for Stripe meter-event dispatch. Keep
# separate from the dashboard session key and empty during shadow mode.
LOYALTY_STRIPE_USAGE_API_KEY_PATH=
WOOCOMMERCE_SIGNING_MATERIAL_PATH=/etc/starfiniti-loyalty/woocommerce-signing-material.json

# Optional tenant OIDC/SAML federation administration. These four paths are
# all-or-none and remain empty until the M13 deployment window is approved.
# Workforce SSO through the existing Supabase custom provider does not use them.
LOYALTY_FEDERATION_CONFIG_PATH=
LOYALTY_AUTHENTIK_API_TOKEN_PATH=
LOYALTY_SUPABASE_SERVICE_ROLE_KEY_PATH=
LOYALTY_FEDERATION_FINGERPRINT_KEY_PATH=

# Optional `smtp` Compose profile. Keep disabled until SMTP is configured.
LOYALTY_SMTP_HOST=
LOYALTY_SMTP_PORT=587
LOYALTY_SMTP_SECURITY=starttls
LOYALTY_SMTP_FROM_ADDRESS=
LOYALTY_SMTP_USERNAME=
LOYALTY_SMTP_PASSWORD_FILE=

# Optional endpoint-isolated `webhook` Compose profile. Keep disabled until
# endpoint, receiver, secret distribution, and exact local-sink evidence pass.
LOYALTY_WEBHOOK_ENDPOINT_ID=
LOYALTY_WEBHOOK_ALLOWED_ORIGIN=
LOYALTY_WEBHOOK_CURRENT_SECRET_PATH=
LOYALTY_WEBHOOK_PREVIOUS_SECRET_PATH=
LOYALTY_WEBHOOK_PREVIOUS_SECRET_FILE=

