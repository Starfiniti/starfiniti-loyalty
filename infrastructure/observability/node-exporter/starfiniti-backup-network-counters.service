[Unit]
Description=Starfiniti semantic backup network counters
Documentation=https://docs.kernel.org/networking/statistics.html
After=local-fs.target

[Service]
Type=oneshot
User=starfiniti-node-exporter
Group=starfiniti-node-exporter
Environment=STARFINITI_BACKUP_NETWORK_METRICS_DIR=/var/lib/node_exporter/textfile_collector
EnvironmentFile=/etc/starfiniti/backup-network-counters.env
ExecStart=/opt/starfiniti/monitoring/starfiniti-backup-network-counters
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
IPAddressDeny=any
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadOnlyPaths=/sys/class/net
ReadWritePaths=/var/lib/node_exporter/textfile_collector
TimeoutStartSec=10s
